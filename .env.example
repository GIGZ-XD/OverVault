# ---------- Mode switches ----------
AUTH_MODE=dev            # dev | wallet
CHAIN_MODE=fake          # fake | real | testnet

# ---------- Backend ----------
DATABASE_URL=postgresql+psycopg://overvault:overvault@localhost:5432/overvault
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=60
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=overvault-private
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
FILE_ENCRYPTION_KEY=change-me-32-byte-base64-key

# ---------- MST EVM Testnet (Phase 6B — contract deployment target) ----------
# MST_RPC_URL   : JSON-RPC endpoint for the MST EVM testnet.
#                 Obtain from https://docs.mstblockchain.com / your MST account.
# MST_CHAIN_ID  : Numeric chain ID for the MST network (used for tx signing).
#                 Check the MST docs — do NOT guess this value.
# These values are used by the connectivity-check test (test_mst_connection.py)
# and will be promoted to contract-deployment config in Phase 6B.
MST_RPC_URL=                         # e.g. https://rpc.testnet.mstblockchain.com
MST_CHAIN_ID=                        # e.g. 2024 (verify in MST docs)
MST_PRIVATE_KEY=                     # testnet-only deployer/signer key, leave empty in git
MST_BACKEND_SIGNER_KEY=              # alias for backend signing key
MSTSCAN_BASE_URL=                    # e.g. https://scan.testnet.mstblockchain.com

# ---------- Real EVM / Local Hardhat (Phase 6A — RealChainService) ----------
# CHAIN_MODE=real activates RealChainService.
# To target MST instead of Hardhat: set EVM_RPC_URL=<MST_RPC_URL value>
# No backend code changes are needed to switch networks.
#
# Quickstart (local Hardhat):
#   cd contracts && npx hardhat node           # terminal 1
#   cd contracts && npx hardhat run scripts/deploy.js  # terminal 2 (copy addresses below)
EVM_RPC_URL=http://127.0.0.1:8545    # swap to MST_RPC_URL value for Phase 6B
EVM_PRIVATE_KEY=                     # Hardhat account #0 key locally; MST key for testnet
CONTRACT_ADDRESS_AUDIT=
CONTRACT_ADDRESS_INTEGRITY=
CONTRACT_ADDRESS_OWNERSHIP=
CONTRACT_ADDRESS_PERMISSION=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MODE=mock          # mock | real
NEXT_PUBLIC_WALLET_MODE=mock       # mock | bridgekey
NEXT_PUBLIC_MSTSCAN_BASE_URL=
