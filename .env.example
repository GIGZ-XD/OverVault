# ---------- Mode switches ----------
AUTH_MODE=dev            # dev | wallet
CHAIN_MODE=fake          # fake | real | testnet

# ---------- Backend ----------
DATABASE_URL=postgresql+psycopg://overvault:overvault@localhost:5432/overvault
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=60
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=overvault-private
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
FILE_ENCRYPTION_KEY=change-me-32-byte-base64-key

# ---------- MST Blockchain (testnet only, never commit real keys) ----------
MST_RPC_URL=
MST_CHAIN_ID=
MST_BACKEND_SIGNER_KEY=  # testnet-only key, leave empty in git
MSTSCAN_BASE_URL=

# ---------- Real EVM / Hardhat Local (Phase 6A — RealChainService) ----------
# Set CHAIN_MODE=real to activate RealChainService.
# Run `npx hardhat node` in contracts/ and deploy with `npx hardhat run scripts/deploy.js`.
EVM_RPC_URL=http://127.0.0.1:8545
EVM_PRIVATE_KEY=                     # first Hardhat test-account key (never commit real keys)
CONTRACT_ADDRESS_AUDIT=
CONTRACT_ADDRESS_INTEGRITY=
CONTRACT_ADDRESS_OWNERSHIP=
CONTRACT_ADDRESS_PERMISSION=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MODE=mock          # mock | real
NEXT_PUBLIC_WALLET_MODE=mock       # mock | bridgekey
NEXT_PUBLIC_MSTSCAN_BASE_URL=
