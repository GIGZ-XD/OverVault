# ==============================================================================
# OverVault Master Environment Configuration Template
# ==============================================================================

# ---------- 1. Mode Switches ----------
AUTH_MODE=dev            # dev | wallet
CHAIN_MODE=real          # fake | demo | real

# ---------- 2. Backend & Database ----------
DATABASE_URL=sqlite:///./overvault.db
API_PREFIX=/api
JWT_SECRET=dev-jwt-secret-change-me-please-32b-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTO_CREATE_TABLES=true

# ---------- 3. Storage & Encryption ----------
STORAGE_DIR=./storage
MASTER_KEY=dev-master-key-change-me
MAX_UPLOAD_MB=25
RUN_EXPIRY_JOB=true
EXPIRY_JOB_INTERVAL_SECONDS=60

# ---------- 4. MST Blockchain Network (Testnet) ----------
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MSTSCAN_BASE_URL=https://mstscan.io
MST_PRIVATE_KEY=0x3e9daaa953be67097e91491c784fb50c0c0ba1e64c370ec5a865a1d3c1b7eb9b
EVM_RPC_URL=https://testnetrpc.mstblockchain.com
EVM_PRIVATE_KEY=0x3e9daaa953be67097e91491c784fb50c0c0ba1e64c370ec5a865a1d3c1b7eb9b

# ---------- 5. MST Smart Contract Addresses ----------
CONTRACT_ADDRESS_AUDIT=0x98686687390Bb44D9B8d240A19Ca9b7c26071Fdb
CONTRACT_ADDRESS_INTEGRITY=0x5e724C47DCEccC41902f2D129091faf6D1D833AB
CONTRACT_ADDRESS_OWNERSHIP=0x53017dd1A227a7Fcf7665C59B7E3360995dCB148
CONTRACT_ADDRESS_PERMISSION=0x6BC2c8B4B373F4a5c3E6Fef36F2E7BA427292b1E

# ---------- 6. Frontend Configuration ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_WALLET_MODE=bridgekey
NEXT_PUBLIC_MSTSCAN_BASE_URL=https://mstscan.io
NEXT_PUBLIC_MST_CHAIN_ID=91562037

